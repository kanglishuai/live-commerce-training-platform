# 复制本文件为 .env 后按本机情况修改（.env 不入库）
# 随机密钥：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=please-change-me-to-a-random-string
TOKEN_EXPIRE_MINUTES=720

# MySQL 连接串（库需先创建：CREATE DATABASE live_training DEFAULT CHARACTER SET utf8mb4;）
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3306/live_training?charset=utf8mb4
DB_ECHO=false

# 前端跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 文件上传目录（相对 backend/ 运行目录）
UPLOAD_DIR=var/uploads

# ===== 以下为可选外部能力：不配置时相关功能自动降级为规则兜底，并在响应 source 字段标明 =====
# 大模型服务（OpenAI 兼容 /chat/completions）
# 示例（DeepSeek，含推理模型 deepseek-flash）：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=sk-xxxx
#   LLM_MODEL=deepseek-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# AI 观众在直播 tick 内调用模型：降频（每 N 个 tick 调一次）+ 短超时，超时即规则兜底，
# 避免推理模型拖慢直播推进节奏
LLM_AUDIENCE_EVERY_N_TICKS=2
LLM_AUDIENCE_TIMEOUT_SECONDS=10

# 服务端语音识别（可选，前端也可用浏览器识别/手动补录）
ASR_BASE_URL=
ASR_API_KEY=
ASR_TIMEOUT_SECONDS=15

# 直播仿真最小 tick 间隔（秒），防止前端误刷
SIM_TICK_MIN_INTERVAL_SECONDS=1.0
